{
  "name": "simplify-living.ch",
  "version": "1.0.0",
  "description": "Pre-rendered static HTML site with i18n support (German/English).",
  "main": "build.js",
  "scripts": {
    "build:css": "sass styles/main.scss styles/main.css --no-source-map",
    "watch:css": "sass --watch styles/main.scss styles/main.css --no-source-map",
    "build": "node build.js",
    "dev": "npm-run-all --parallel watch:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "^1.94.1"
  }
}
